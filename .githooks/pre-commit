#!/bin/sh
# Git pre-commit hook: runs the hooks in .pre-commit-config.yaml on the staged
# changes. Enabled with `git config core.hooksPath .githooks` (the dev
# container does this in post-create; see CONTRIBUTING.md).
#
# Committed to the repo, not generated by `pre-commit install`, so it works
# both inside the dev container and on the host: the repo folder (and so
# .git/config) is shared between them, and a generated hook would be
# hard-wired to the container's /workspace/.venv/bin/python.
#
# Uses pre-commit from PATH when available (e.g. the activated .venv);
# otherwise runs it through uvx, in uv's tool cache, without touching .venv.

# GUI Git clients (GitHub Desktop, IDEs) often don't inherit the login shell's
# PATH, so also look where uv's installer puts uv/uvx. Appended, so anything
# already on PATH still wins.
PATH="$PATH:$HOME/.local/bin:$HOME/.cargo/bin"

if command -v pre-commit >/dev/null 2>&1; then
    exec pre-commit run --hook-stage pre-commit
elif command -v uvx >/dev/null 2>&1; then
    # Keep in step with the pre-commit constraint in pyproject.toml.
    exec uvx --from 'pre-commit>=4.6,<5' pre-commit run --hook-stage pre-commit
else
    echo "pre-commit hook: neither pre-commit nor uv was found on PATH." >&2
    echo "Install uv (https://docs.astral.sh/uv/) and commit again." >&2
    exit 1
fi
